{
 "version": 1,
 "match": {
  "exe": [
   "KINGDOM HEARTS FINAL MIX.exe",
   "KINGDOM HEARTS II FINAL MIX.exe"
  ]
 },
 "machine": "x64",
 "add_arguments": [
  {
   "unless": "-AUTH_LOGIN=",
   "add": "-AUTH_LOGIN=unused"
  },
  {
   "unless": "-AUTH_PASSWORD=",
   "add": "-AUTH_PASSWORD=00000000000000000000000000000000"
  },
  {
   "unless": "-AUTH_TYPE=",
   "add": "-AUTH_TYPE=exchangecode"
  },
  {
   "unless": "-epicapp=",
   "add": "-epicapp=68c214c58f694ae88c2dab6f209b43e4"
  },
  {
   "unless": "-epicenv=",
   "add": "-epicenv=Prod"
  },
  {
   "unless": "-EpicPortal",
   "add": "-EpicPortal"
  },
  {
   "unless": "-epicusername=",
   "add": "-epicusername=Player"
  },
  {
   "unless": "-epicuserid=",
   "add": "-epicuserid=1638"
  },
  {
   "unless": "-epiclocale=",
   "add": "-epiclocale=en"
  }
 ]
}
